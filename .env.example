# Offline mock/replay fallback when DATABASE_URL is empty.
ALGOSHIELD_DB=data/platform.db
# Keep real values only in ignored .env.local or process environment.
DATABASE_URL=
# Demo-only passwordless role selector. Enable only on SQLite or a dedicated
# non-production Neon branch; startup refuses this mode when NEON_BRANCH=production.
ALGOSHIELD_DEMO_ROLE_MODE=false
ALGOSHIELD_DEMO_TRADER_USERNAME=demo_trader
ALGOSHIELD_DEMO_TRADER_ACCOUNT=acc_demo_trader
ALGOSHIELD_DEMO_OPERATOR_USERNAME=demo_operator
ALGOSHIELD_DEMO_OPERATOR_ACCOUNT=acc_demo_operator
# Optional loopback HTTP mock broker for end-to-end local simulation.
MOCK_BROKER_URL=http://127.0.0.1:9001

# Live 021 developer API (disabled by default; keep credentials only in ignored .env.local)
# ALGOSHIELD_021_ENABLED=false
# Dedicated SQLite execution ledger used only when 021 is enabled. Never point
# this at the offline mock/replay ALGOSHIELD_DB file.
# ALGOSHIELD_021_DB=data/platform-021.db
# ALGOSHIELD_021_BASE_URL=https://devapi.021.trade/api/developer-api/v1
# ALGOSHIELD_021_USERNAME=HACK...
# ALGOSHIELD_021_PASSWORD=
# ALGOSHIELD_021_TOKEN=
# ALGOSHIELD_021_INSTRUMENT_CACHE=data/021_instruments.csv.gz
# Cash-and-carry is the broadest demo-compatible product for cash equities.
# ALGOSHIELD_021_PRODUCT=CNC
# ALGOSHIELD_MARKET_DATA_PROVIDER=021  # primary when 021 is enabled
# Optional pinned symbols. The live universe is this list plus symbols used by
# enabled strategy subscriptions. With neither, the provider remains idle.
# ALGOSHIELD_021_SYMBOLS=RELIANCE,TCS
# ALGOSHIELD_021_MAX_TIMESTAMP_SKEW_SECONDS=10
# ALGOSHIELD_BROKER_READ_TIMEOUT_SECONDS=8
# ALGOSHIELD_BROKER_WRITE_TIMEOUT_SECONDS=8
# ALGOSHIELD_RECONCILIATION_TIMEOUT_SECONDS=10
# Prototype-responsive Auto mode. Orders remain quantity one and still require
# the global gate, reconciliation, fresh intent-symbol evidence and central risk.
# ALGOSHIELD_AUTO_SCAN_LIMIT=200
# ALGOSHIELD_AUTO_MAX_POSITIONS=1
# ALGOSHIELD_AUTO_LOOKBACK_UPDATES=2
# ALGOSHIELD_AUTO_MIN_WARMED_SYMBOLS=1
# ALGOSHIELD_AUTO_ENTRY_MOMENTUM=0.0001
# ALGOSHIELD_AUTO_TAKE_PROFIT=0.0005
# ALGOSHIELD_AUTO_STOP_LOSS=0.0005
# ALGOSHIELD_AUTO_COOLDOWN_SECONDS=2
# Optional Yahoo fallback is a clean-start mode with 021 explicitly disabled.
# It is never activated automatically after a 021 failure and cannot share a
# running candle timeline or live 021 broker session.
# ALGOSHIELD_021_ENABLED=false
# ALGOSHIELD_MARKET_DATA_PROVIDER=yahoo
# ALGOSHIELD_YAHOO_SYMBOLS=TCS.NS,INFY.NS
# Optional isolated PostgreSQL URL for rollback-only integration tests.
ALGOSHIELD_TEST_DATABASE_URL=
# Exact browser origins; replace for deployment. Never derive trust from Host.
ALGOSHIELD_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Local HTTP only. Set true only behind approved TLS; no forwarded-header trust.
ALGOSHIELD_SECURE_COOKIE=false
# Non-secret intended linkage; CLI link must still verify actual project/branch.
NEON_PROJECT_ID=soft-glade-57602806
NEON_BRANCH=production
